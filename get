-- Captura o outfit do seu personagem em JSON (inclui LAYERED CLOTHING + Position/Rotation/Scale).
-- Rodar na barra de comando do Studio (View > Command Bar) com o jogo em Play.

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")

local player = Players:GetPlayers()[1]
if not player or not player.Character then
	return warn("❌ Sem player/Character")
end
local humanoid = player.Character:FindFirstChildOfClass("Humanoid")
if not humanoid then
	return warn("❌ Sem Humanoid")
end

local SIMPLE_KEYS = {
	"Shirt", "Pants", "GraphicTShirt", "Face", "Head", "Torso", "LeftArm", "RightArm", "LeftLeg", "RightLeg",
	"BodyTypeScale", "HeadScale", "HeightScale", "WidthScale", "ProportionScale", "DepthScale",
	"ClimbAnimation", "FallAnimation", "IdleAnimation", "JumpAnimation", "MoodAnimation",
	"RunAnimation", "StaticFacialAnimation", "SwimAnimation", "WalkAnimation",
}
local COLOR_KEYS = { "SkinColor", "HeadColor", "TorsoColor", "LeftArmColor", "RightArmColor", "LeftLegColor", "RightLegColor" }

local function getDescription()
	local ok, desc = pcall(function()
		return humanoid:GetAppliedDescription()
	end)
	if ok and desc then
		return desc
	end
	return humanoid:FindFirstChildOfClass("HumanoidDescription")
end

-- Vector3 -> tabela {X,Y,Z}
local function vecToTable(v)
	if typeof(v) ~= "Vector3" then return nil end
	return { X = v.X, Y = v.Y, Z = v.Z }
end

local function buildJSON()
	local hd = getDescription()
	if not hd then
		return "{}"
	end
	local t = {}

	for _, k in ipairs(SIMPLE_KEYS) do
		local ok, v = pcall(function() return hd[k] end)
		if ok and v ~= nil and v ~= 0 then
			t[k] = v
		end
	end

	for _, k in ipairs(COLOR_KEYS) do
		local ok, v = pcall(function() return hd[k] end)
		if ok and typeof(v) == "Color3" then
			t[k] = v:ToHex()
		end
	end

	-- Todos os acessórios: rígidos E layered, com Position/Rotation/Scale direto do AccessoryDescription
	t._Accessories = {}
	local ok, list = pcall(function() return hd:GetAccessories(true) end)
	if ok then
		for _, a in ipairs(list) do
			if a.AssetId and a.AssetId ~= 0 then
				local e = {
					AssetId = a.AssetId,
					AccessoryType = a.AccessoryType and a.AccessoryType.Name or "Unknown",
					IsLayered = a.IsLayered == true,
				}
				if e.IsLayered then
					e.Order = a.Order
					e.Puffiness = a.Puffiness
				end
				-- Position, Rotation e Scale vêm direto do AccessoryDescription
				local okP, pos = pcall(function() return a.Position end)
				if okP and typeof(pos) == "Vector3" and pos.Magnitude > 0 then
					e.Position = vecToTable(pos)
				end
				local okR, rot = pcall(function() return a.Rotation end)
				if okR and typeof(rot) == "Vector3" and rot.Magnitude > 0 then
					e.Rotation = vecToTable(rot)
				end
				local okS, scl = pcall(function() return a.Scale end)
				if okS and typeof(scl) == "Vector3" and scl.Magnitude > 0 then
					e.Scale = vecToTable(scl)
				end
				table.insert(t._Accessories, e)
			end
		end
	end

	local layered, comTransform = 0, 0
	for _, e in ipairs(t._Accessories) do
		if e.IsLayered then layered += 1 end
		if e.Position or e.Rotation or e.Scale then comTransform += 1 end
	end
	print(("📋 %d acessórios (%d layered, %d com transform)"):format(#t._Accessories, layered, comTransform))

	return HttpService:JSONEncode(t)
end

