-- Arrastar pela barra
local conns = {}
local dragging, dragStart, origin = false, nil, nil
table.insert(conns, bar.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging, dragStart, origin = true, i.Position, frame.Position
	end
end))
table.insert(conns, UIS.InputChanged:Connect(function(i)
	if dragging and i.UserInputType == Enum.UserInputType.MouseMovement then
		local d = i.Position - dragStart
		frame.Position = UDim2.new(origin.X.Scale, origin.X.Offset + d.X, origin.Y.Scale, origin.Y.Offset + d.Y)
	end
end))
table.insert(conns, UIS.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end))

closeBtn.MouseButton1Click:Connect(function()
	for _, c in ipairs(conns) do c:Disconnect() end
	gui:Destroy()
end)
